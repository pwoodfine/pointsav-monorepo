{
  "productName": "Workplace Presentation",
  "mainBinaryName": "Workplace Presentation",
  "version": "0.1.0",
  "identifier": "systems.pointsav.workplace-presentation",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Workplace Presentation",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 PointSav Digital Systems",
    "category": "Productivity",
    "shortDescription": "Sovereign offline presentation tool",
    "longDescription": "A local-first presentation tool producing self-contained output. No cloud. No account. EUPL-1.2 licensed.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
