<?xml version="1.0" encoding="UTF-8"?>
<!--
  os-totebox Phase H1 — Microkit system description.

  7-PD Sovereign WORM Data Vault.
  Translated from moonshot-toolkit/examples/os-totebox.toml.

  Channel IDs match moonshot-sel4-vmm/src/pd.rs `channels` module constants:
    watchdog-pd:          WD_SERVICE_FS=0, WD_NETWORK_PD=1, WD_SERVICE_CONTENT=2,
                          WD_SERVICE_PEOPLE=3, WD_SERVICE_SLM=4, WD_SERVICE_EXTRACTION=5
    service-fs-pd:        FS_WATCHDOG=0, FS_FROM_EXTRACTION=1
    network-pd:           NETWORK_WATCHDOG=0
    service-content-pd:   CONTENT_WATCHDOG=0
    service-people-pd:    PEOPLE_WATCHDOG=0
    service-slm-pd:       SLM_WATCHDOG=0
    service-extraction-pd:EXTRACTION_WATCHDOG=0, EXTRACTION_TO_FS=1
-->
<system>
    <!-- Ring 0: Supervisor -->
    <protection_domain name="watchdog-pd" priority="250">
        <program_image path="watchdog-pd.elf" />
    </protection_domain>

    <!-- Ring 1: Storage-touching PDs -->
    <protection_domain name="service-fs-pd" priority="200">
        <program_image path="service-fs-pd.elf" />
    </protection_domain>

    <protection_domain name="network-pd" priority="180">
        <program_image path="network-pd.elf" />
    </protection_domain>

    <protection_domain name="service-extraction-pd" priority="110">
        <program_image path="service-extraction-pd.elf" />
    </protection_domain>

    <!-- Ring 2: Deterministic processing PDs -->
    <protection_domain name="service-content-pd" priority="150">
        <program_image path="service-content-pd.elf" />
    </protection_domain>

    <protection_domain name="service-people-pd" priority="130">
        <program_image path="service-people-pd.elf" />
    </protection_domain>

    <protection_domain name="service-slm-pd" priority="120">
        <program_image path="service-slm-pd.elf" />
    </protection_domain>

    <!-- Channels: watchdog-pd heartbeat to all 6 service PDs -->
    <channel>
        <end pd="watchdog-pd" id="0" />
        <end pd="service-fs-pd" id="0" />
    </channel>

    <channel>
        <end pd="watchdog-pd" id="1" />
        <end pd="network-pd" id="0" />
    </channel>

    <channel>
        <end pd="watchdog-pd" id="2" />
        <end pd="service-content-pd" id="0" />
    </channel>

    <channel>
        <end pd="watchdog-pd" id="3" />
        <end pd="service-people-pd" id="0" />
    </channel>

    <channel>
        <end pd="watchdog-pd" id="4" />
        <end pd="service-slm-pd" id="0" />
    </channel>

    <channel>
        <end pd="watchdog-pd" id="5" />
        <end pd="service-extraction-pd" id="0" />
    </channel>

    <!-- Channel: service-extraction-pd notifies service-fs-pd on watch-drop -->
    <channel>
        <end pd="service-extraction-pd" id="1" />
        <end pd="service-fs-pd" id="1" />
    </channel>
</system>
